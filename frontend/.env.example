#   VITE_PORTAL=FIELD       -> State Treasury & District Agency only
#   VITE_PORTAL=CONTRACTOR  -> Contractor Portal only (Registration & Login)
#   VITE_PORTAL=PUBLIC      -> Public Transparency Portal only (No login)
#   VITE_PORTAL=AUDITOR     -> CAG Auditor Portal only
# ==============================================================================
VITE_PORTAL=ADMIN
