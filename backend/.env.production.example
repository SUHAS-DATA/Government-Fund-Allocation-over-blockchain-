# ==============================================================================
# PFMS Backend Cloud Deployment Configuration (Render / Railway / Cloud VM)
# Set these in your Render Dashboard -> Environment Variables
# NEVER commit real private keys, API secrets, or passwords to Git.
# ==============================================================================

# Application Environment
APP_ENV=production
PORT=10000

# Cloud Database (MongoDB Atlas)
MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.your-cluster.mongodb.net/
MONGODB_DB_NAME=FUNDSYSTEM

# Security JWT Key (Minimum 32 random characters for HS256)
JWT_SECRET=generate_a_random_32_plus_character_secret_key_here

# Blockchain Activation Guard
# Set to 'true' to enable live Ethereum Sepolia verification and transactions
ENABLE_BLOCKCHAIN=true

# Hosted Contract Configuration File Selection
# Loads backend/config/contract_info.hosted.json containing verified Sepolia address and ABI
CONTRACT_INFO_FILE=contract_info.hosted.json

# Hosted EVM Testnet RPC Configuration (Ethereum Sepolia, Chain ID: 11155111)
# Configure your HTTPS JSON-RPC endpoint from Alchemy, Infura, or QuickNode
RPC_URL=https://eth-sepolia.g.alchemy.com/v2/YOUR_ALCHEMY_API_KEY
BLOCKCHAIN_RPC_URL=https://eth-sepolia.g.alchemy.com/v2/YOUR_ALCHEMY_API_KEY
CHAIN_ID=11155111
CONTRACT_ADDRESS=0x103cdC78636491B20deadC5574755Bbd64B119c6

# Testnet Signer Keys (Never commit to Git - configure directly in Render Dashboard)
# Current Sepolia deployer wallet: 0xeCcD57EfadFCc6217a21Bf482FEBe18c9F3D6148
SEPOLIA_DEPLOYER_PRIVATE_KEY=your_sepolia_deployer_wallet_private_key
SUPER_ADMIN_PRIVATE_KEY=your_sepolia_deployer_wallet_private_key
FINANCE_PRIVATE_KEY=your_sepolia_deployer_wallet_private_key
STATE_PRIVATE_KEY=your_sepolia_deployer_wallet_private_key
DISTRICT_PRIVATE_KEY=your_sepolia_deployer_wallet_private_key
CONTRACTOR_PRIVATE_KEY=your_sepolia_deployer_wallet_private_key

# CORS Allowed Origins (Comma-separated exact domains for the 5 portals)
CORS_ORIGINS=https://government-fund-allocation-over-blo.vercel.app,https://govfund-field.vercel.app,https://govfund-contractor.vercel.app,https://govfund-public.vercel.app,https://govfund-auditor.vercel.app

# Public Frontend URL (Used for QR code verification links)
FRONTEND_URL=https://government-fund-allocation-over-blo.vercel.app
