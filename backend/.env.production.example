# ==============================================================================
# PFMS Backend Cloud Deployment Configuration (Render / Railway / Cloud VM)
# Set these in your Render/Railway Environment Variables dashboard
# ==============================================================================

# Server Port (Render sets $PORT automatically, but good to have a default)
PORT=10000

# Cloud Database (e.g. MongoDB Atlas cluster connection string)
# Format: mongodb+srv://<username>:<password>@cluster0.xyz.mongodb.net/?retryWrites=true&w=majority
MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.your-cluster.mongodb.net/
MONGODB_DB_NAME=FUNDSYSTEM

# Security JWT Key
JWT_SECRET=super_secret_national_pfs_blockchain_key_2026_production

# Blockchain RPC Configuration
# Set this to your public RPC URL (e.g., ngrok tunnel or Alchemy/Infura Sepolia RPC)
BLOCKCHAIN_RPC_URL=https://your-public-rpc-or-tunnel.ngrok-free.app
RPC_URL=https://your-public-rpc-or-tunnel.ngrok-free.app
CONTRACT_ADDRESS=0x7A259d42d1F6e24cfF76aDDF89eEBDAC195E1c20
CHAIN_ID=5777

# Multi-Tier Department Private Keys
FINANCE_PRIVATE_KEY=0x5c1773faf03c71052871f2ce322dc5b61bedc26b92f9a1943d408b81edb378ba
STATE_PRIVATE_KEY=0x8227b5bce285ad9e8a2d06c6dba71cf7734ddc3e273f491a33a62283b9b18473
DISTRICT_PRIVATE_KEY=0xd370fdcbda2d39b300ff21d1d60695c8c24aeb3fa068e5c894684f4704a15c79
CONTRACTOR_PRIVATE_KEY=0xfd55cc94a1342b59e57dcccb78832e52ac1da472a1f39f08d1673c79146e542b
BLOCKCHAIN_PRIVATE_KEY=0x5c1773faf03c71052871f2ce322dc5b61bedc26b92f9a1943d408b81edb378ba

# CORS Allowed Origins
# Specify your Vercel URL (e.g. https://your-frontend.vercel.app) or leave empty to allow all Vercel domains
CORS_ORIGINS=https://your-project.vercel.app,http://localhost:5173
