PORT=5000
MONGODB_URI=mongodb://127.0.0.1:27017
MONGODB_DB_NAME=FUNDSYSTEM
JWT_SECRET=super_secret_national_pfs_blockchain_key_2026

# Blockchain RPC & Single Contract (Set ENABLE_BLOCKCHAIN=false on cloud deployments)
ENABLE_BLOCKCHAIN=true
BLOCKCHAIN_RPC_URL=http://127.0.0.1:7545
RPC_URL=http://127.0.0.1:7545
CONTRACT_ADDRESS=0x7A259d42d1F6e24cfF76aDDF89eEBDAC195E1c20

# Multi-Tier Department Wallets (Three Separate Wallets for Fund Transfers)
# Stage 1: Finance -> State (Account 1 / Finance Signer)
FINANCE_PRIVATE_KEY=your_finance_private_key_account_1
FINANCE_WALLET_ADDRESS=0x0000000000000000000000000000000000000000

# Stage 2: State -> District (Account 2 / State Signer)
STATE_PRIVATE_KEY=your_state_private_key_account_2
STATE_WALLET_ADDRESS=0x0000000000000000000000000000000000000000

# Stage 3: District -> Contractor (Account 3 / District Signer)
DISTRICT_PRIVATE_KEY=your_district_private_key_account_3
DISTRICT_WALLET_ADDRESS=0x0000000000000000000000000000000000000000

# Contractor Wallet (Milestones & Escrow Recipient)
CONTRACTOR_PRIVATE_KEY=your_contractor_private_key_account_4
CONTRACTOR_WALLET_ADDRESS=0x0000000000000000000000000000000000000000

# Fallback master key (Local development only)
BLOCKCHAIN_PRIVATE_KEY=your_finance_private_key_account_1
